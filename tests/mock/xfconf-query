#!/usr/bin/env python3
"""Faux xfconf-query pour les tests : stocke les propriétés dans $XFCONF_MOCK_DB (JSON)."""
import json
import os
import sys

db = os.environ["XFCONF_MOCK_DB"]
d = json.load(open(db)) if os.path.exists(db) else {}
a = sys.argv[1:]
ch = a[a.index("-c") + 1]
if "-l" in a:
    print("\n".join(k.split(":", 1)[1] for k in d if k.startswith(ch + ":")))
    sys.exit(0)
p = a[a.index("-p") + 1]
k = ch + ":" + p
if "-r" in a:
    for x in list(d):
        if x == k or ("-R" in a and x.startswith(k + "/")):
            d.pop(x)
elif "-s" in a:
    vals = [a[i + 1] for i, x in enumerate(a) if x == "-s"]
    if k not in d and "--create" not in a:
        sys.exit(1)
    d[k] = vals if (len(vals) > 1 or "--force-array" in a) else vals[0]
else:
    if k not in d:
        sys.exit(1)
    v = d[k]
    print("Value is an array with %d items:\n\n" % len(v) + "\n".join(v) if isinstance(v, list) else v)
    sys.exit(0)
json.dump(d, open(db, "w"), indent=1)
