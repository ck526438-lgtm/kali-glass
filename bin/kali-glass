#!/usr/bin/env python3
"""kali-glass — applique le bureau « Glass » façon macOS sur Kali Linux (XFCE).

Commandes :
  kali-glass apply [--light] [--wallpaper NOM]   applique tout le thème
  kali-glass wallpaper NOM|CHEMIN                change le fond d'écran
  kali-glass list                                liste les fonds fournis
  kali-glass mode dark|light                     thème sombre / clair
  kali-glass blur 0-20                           force du flou (0 = désactivé)
  kali-glass panel-opacity 0-100                 opacité de la barre du haut
  kali-glass dock on|off                         dock Plank façon macOS
  kali-glass dynamic on|off                      fond d'écran qui suit l'heure
  kali-glass install-themes                      (re)télécharge WhiteSur GTK/icônes/curseurs
  kali-glass login                               fond Glass sur l'écran de connexion (sudo)
  kali-glass restore                             remet les réglages d'origine
  kali-glass status                              affiche l'état actuel
  kali-glass doctor                              diagnostic (dépendances, GPU, thèmes)
  kali-glass live set NOM|FICHIER|URL            fond d'écran ANIMÉ (vidéo 4K en boucle)
  kali-glass live download                       télécharge le pack de fonds animés
  kali-glass live list | stop | toggle | add | options
"""
import argparse
import datetime
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

VERSION = "1.2.0"
HOME = Path.home()
CONF_DIR = HOME / ".config" / "kali-glass"
STATE_FILE = CONF_DIR / "state.json"
LOG_FILE = HOME / ".cache" / "kali-glass" / "kali-glass.log"
VERBOSE = False
COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ
DATA_DIRS = [
    Path(os.environ.get("KALI_GLASS_DATA", "")) if os.environ.get("KALI_GLASS_DATA") else None,
    Path(__file__).resolve().parent.parent,                # lancé depuis le dépôt git
    Path("/usr/share/kali-glass"),                           # installé via .deb / install.sh
    HOME / ".local" / "share" / "kali-glass",
]
THEMES_DIR = HOME / ".themes"
ICONS_DIR = HOME / ".local" / "share" / "icons"

DYNAMIC_SCHEDULE = [  # (heure de début, fond)
    (6, "light"), (11, "ocean"), (17, "sunset"), (20, "aurora"), (23, "midnight"),
]

# ───────────────────────── utilitaires ─────────────────────────

def data_dir() -> Path:
    for d in DATA_DIRS:
        if d and (d / "wallpapers").is_dir():
            return d
    die("Données Kali Glass introuvables (dossier wallpapers/). Réinstalle le paquet.")


def _c(code, text):
    return f"\033[{code}m{text}\033[0m" if COLOR else text


def log(msg):
    """Journal persistant : ~/.cache/kali-glass/kali-glass.log (utile pour les rapports de bug)."""
    try:
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with LOG_FILE.open("a", encoding="utf-8") as f:
            f.write(f"{datetime.datetime.now().isoformat(timespec='seconds')} {msg}\n")
        if LOG_FILE.stat().st_size > 512_000:  # rotation simple
            LOG_FILE.replace(LOG_FILE.with_suffix(".log.1"))
    except OSError:
        pass


def die(msg, code=1):
    log(f"ERROR {msg}")
    print(f"{_c('1;31', '✗')} {msg}", file=sys.stderr)
    sys.exit(code)


def info(msg):
    log(f"INFO  {msg}")
    print(f"{_c('1;36', '›')} {msg}", flush=True)


def ok(msg):
    log(f"OK    {msg}")
    print(f"{_c('1;32', '✓')} {msg}", flush=True)


def warn(msg):
    log(f"WARN  {msg}")
    print(f"  {_c('1;33', '⚠')} {msg}", flush=True)


def have(cmd):
    return shutil.which(cmd) is not None


def run(cmd, check=False, quiet=True, **kw):
    if VERBOSE:
        print(_c("2", "  $ " + " ".join(str(c) for c in cmd)), flush=True)
    try:
        r = subprocess.run(cmd, check=check, text=True,
                           stdout=subprocess.PIPE if quiet else None,
                           stderr=subprocess.PIPE if quiet else None, **kw)
    except FileNotFoundError:
        r = subprocess.CompletedProcess(cmd, 127, "", "")
    if r.returncode not in (0, None) and cmd and cmd[0] not in ("pgrep", "pkill", "fc-list"):
        log(f"CMD   rc={r.returncode} {' '.join(map(str, cmd))} :: {(r.stderr or '').strip()[:200]}")
    return r


def load_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except Exception:
        return {"backup": {}, "settings": {}}


def save_state(st):
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(st, indent=2, ensure_ascii=False))


# ───────────────────────── xfconf ─────────────────────────

def xf_get(channel, prop):
    r = run(["xfconf-query", "-c", channel, "-p", prop])
    if r.returncode != 0:
        return None
    out = r.stdout.strip()
    if out.startswith("Value is an array"):
        vals = [ln.strip() for ln in out.splitlines()[1:] if ln.strip()]
        return {"array": vals}
    return out


def _backup(st, channel, prop):
    key = f"{channel}:{prop}"
    if key not in st["backup"]:
        st["backup"][key] = xf_get(channel, prop)


def xf_set(st, channel, prop, value, typ):
    """Fixe une propriété xfconf en sauvegardant la valeur d'origine."""
    if not have("xfconf-query"):
        return False
    _backup(st, channel, prop)
    if typ == "bool":
        value = "true" if value else "false"
    r = run(["xfconf-query", "-c", channel, "-p", prop, "--create", "-t", typ, "-s", str(value)])
    if r.returncode != 0:  # type différent déjà présent → on remplace
        run(["xfconf-query", "-c", channel, "-p", prop, "-r"])
        r = run(["xfconf-query", "-c", channel, "-p", prop, "--create", "-t", typ, "-s", str(value)])
    return r.returncode == 0


def xf_set_array(st, channel, prop, values, typ):
    if not have("xfconf-query"):
        return False
    _backup(st, channel, prop)
    run(["xfconf-query", "-c", channel, "-p", prop, "-r"])
    cmd = ["xfconf-query", "-c", channel, "-p", prop, "--create", "--force-array"]
    for v in values:
        cmd += ["-t", typ, "-s", str(v)]
    return run(cmd).returncode == 0


def xf_list(channel):
    r = run(["xfconf-query", "-c", channel, "-l"])
    return r.stdout.split() if r.returncode == 0 else []


# ───────────────────────── thèmes WhiteSur ─────────────────────────

REPOS = {
    "gtk": "https://github.com/vinceliuice/WhiteSur-gtk-theme.git",
    "icons": "https://github.com/vinceliuice/WhiteSur-icon-theme.git",
    "cursors": "https://github.com/vinceliuice/WhiteSur-cursors.git",
}


def find_theme(mode):
    want = "Light" if mode == "light" else "Dark"
    for base in (THEMES_DIR, HOME / ".local/share/themes", Path("/usr/share/themes")):
        if base.is_dir():
            for d in sorted(base.iterdir()):
                if d.name.startswith("WhiteSur") and want in d.name and (d / "gtk-3.0").is_dir():
                    return d.name
    return None


def find_icons(mode):
    for base in (ICONS_DIR, HOME / ".icons", Path("/usr/share/icons")):
        if base.is_dir():
            names = {d.name for d in base.iterdir()}
            for n in (f"WhiteSur-{mode}", "WhiteSur"):
                if n in names:
                    return n
    return None


def find_cursors():
    for base in (ICONS_DIR, HOME / ".icons", Path("/usr/share/icons")):
        if (base / "WhiteSur-cursors").is_dir():
            return "WhiteSur-cursors"
    return None


def install_themes(force=False):
    if not force and find_theme("dark") and find_icons("dark"):
        ok("Thèmes WhiteSur déjà présents")
        return
    if not have("git"):
        die("git est requis : sudo apt install git")
    tmp = Path(tempfile.mkdtemp(prefix="kali-glass-"))
    try:
        for key, url in REPOS.items():
            info(f"Téléchargement {url.rsplit('/', 1)[-1][:-4]}…")
            dest = tmp / key
            if run(["git", "clone", "--depth", "1", url, str(dest)], quiet=False).returncode != 0:
                warn(f"échec du clonage de {key}, on continue")
                continue
            if key == "gtk":
                r = run(["bash", "./install.sh", "-c", "dark", "-c", "light", "-l"], cwd=dest, quiet=False)
                if r.returncode != 0:
                    run(["bash", "./install.sh"], cwd=dest, quiet=False)
            else:
                run(["bash", "./install.sh"], cwd=dest, quiet=False)
        ok("Thèmes WhiteSur installés")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


# ───────────────────────── fonds d'écran ─────────────────────────

def wallpapers():
    return sorted((data_dir() / "wallpapers").glob("kali-glass-*.jpg"))


def resolve_wallpaper(name):
    p = Path(os.path.expanduser(name))
    if p.is_file():
        return p.resolve()
    for w in wallpapers():
        if w.stem == name or w.stem == f"kali-glass-{name}":
            return w
    die(f"Fond « {name} » introuvable. Disponibles : " + ", ".join(w.stem.replace('kali-glass-', '') for w in wallpapers()))


def monitors():
    r = run(["xrandr", "--listmonitors"])
    names = re.findall(r"\s(\S+)$", r.stdout, re.M) if r.returncode == 0 else []
    return [n for n in names if n and not n.startswith("Monitors")] or ["0", "eDP-1", "HDMI-1", "Virtual1", "Virtual-1"]


def set_wallpaper(st, name):
    path = resolve_wallpaper(name)
    props = [p for p in xf_list("xfce4-desktop") if p.endswith("/last-image")]
    if not props:
        props = [f"/backdrop/screen0/monitor{m}/workspace{w}/last-image" for m in monitors() for w in range(4)]
    for p in props:
        xf_set(st, "xfce4-desktop", p, str(path), "string")
        xf_set(st, "xfce4-desktop", p.replace("last-image", "image-style"), 5, "int")  # zoomé
    st["settings"]["wallpaper"] = path.stem.replace("kali-glass-", "") if path.parent == data_dir() / "wallpapers" else str(path)
    ok(f"Fond d'écran : {path.name}")


def dynamic_pick(hour=None):
    hour = datetime.datetime.now().hour if hour is None else hour
    pick = DYNAMIC_SCHEDULE[-1][1]
    for start, name in DYNAMIC_SCHEDULE:
        if hour >= start:
            pick = name
    return pick


# ───────────────────────── picom / plank ─────────────────────────

AUTOSTART = HOME / ".config" / "autostart"


def write_autostart(name, exec_cmd, comment):
    AUTOSTART.mkdir(parents=True, exist_ok=True)
    (AUTOSTART / f"kali-glass-{name}.desktop").write_text(
        "[Desktop Entry]\nType=Application\n"
        f"Name=Kali Glass {name}\nComment={comment}\nExec={exec_cmd}\n"
        "X-GNOME-Autostart-enabled=true\nHidden=false\nNoDisplay=false\n"
    )


def remove_autostart(name):
    f = AUTOSTART / f"kali-glass-{name}.desktop"
    if f.exists():
        f.unlink()


def picom_conf_path():
    return HOME / ".config" / "picom" / "kali-glass.conf"


def setup_picom(st, strength=None):
    if not have("picom"):
        warn("picom absent (sudo apt install picom) — pas de flou")
        return
    src = data_dir() / "config" / "picom" / "picom.conf"
    dst = picom_conf_path()
    dst.parent.mkdir(parents=True, exist_ok=True)
    text = src.read_text()
    strength = st["settings"].get("blur", 7) if strength is None else strength
    if strength <= 0:
        text = re.sub(r"blur: \{.*?\};", "blur: { method = \"none\"; };", text, flags=re.S)
    else:
        text = re.sub(r"strength = \d+;", f"strength = {min(20, int(strength))};", text)
    dst.write_text(text)
    st["settings"]["blur"] = int(strength)
    # le compositeur interne de xfwm4 entre en conflit avec picom
    xf_set(st, "xfwm4", "/general/use_compositing", False, "bool")
    write_autostart("picom", f"picom --config {dst}", "Compositeur verre (flou)")
    restart_picom()
    ok(f"Flou verre : {'désactivé' if strength <= 0 else strength}")


def restart_picom():
    if not os.environ.get("DISPLAY"):
        return
    run(["pkill", "-x", "picom"])
    time.sleep(0.4)
    proc = subprocess.Popen(["picom", "--config", str(picom_conf_path())],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    time.sleep(1.5)
    if proc.poll() is not None:  # GPU/VM sans OpenGL : repli sans flou mais avec transparence
        warn("picom (glx) n'a pas démarré — repli sur xrender (transparence sans flou)")
        subprocess.Popen(["picom", "--config", str(picom_conf_path()), "--backend", "xrender"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


DOCK_APPS = ["thunar", "xfce4-terminal", "firefox-esr", "kali-burpsuite", "org.wireshark.Wireshark",
             "mousepad", "glass-center", "xfce4-settings-manager"]


def dock_desktop_files():
    out = []
    for app in DOCK_APPS:
        for d in ("/usr/share/applications", str(HOME / ".local/share/applications")):
            f = Path(d) / f"{app}.desktop"
            if f.exists():
                out.append(f)
                break
    return out


def setup_dock(st, enabled=True):
    st["settings"]["dock"] = enabled
    if not enabled:
        remove_autostart("plank")
        run(["pkill", "-x", "plank"])
        remove_xfce_dock(st)
        ok("Dock désactivé")
        return
    engine = os.environ.get("KALI_GLASS_DOCK", "auto")  # auto | plank | xfce
    if engine == "plank" or (engine == "auto" and have("plank")):
        setup_plank(st)
    else:
        setup_xfce_dock(st)


def setup_plank(st):
    remove_xfce_dock(st)
    tdir = HOME / ".local" / "share" / "plank" / "themes" / "KaliGlass"
    tdir.mkdir(parents=True, exist_ok=True)
    shutil.copy(data_dir() / "config" / "plank" / "KaliGlass" / "dock.theme", tdir / "dock.theme")
    schema = "net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/"
    for k, v in [("theme", "'KaliGlass'"), ("zoom-enabled", "true"), ("zoom-percent", "150"),
                 ("icon-size", "48"), ("hide-mode", "'intelligent'"), ("position", "'bottom'"),
                 ("alignment", "'center'"), ("show-dock-item", "false")]:
        run(["gsettings", "set", schema, k, v])
    launchers = HOME / ".config" / "plank" / "dock1" / "launchers"
    if not launchers.is_dir() or not any(launchers.iterdir()):
        launchers.mkdir(parents=True, exist_ok=True)
        for f in dock_desktop_files():
            (launchers / f"{f.stem}.dockitem").write_text(f"[PlankDockItemPreferences]\nLauncher=file://{f}\n")
    write_autostart("plank", "plank", "Dock façon macOS")
    if os.environ.get("DISPLAY"):
        run(["pkill", "-x", "plank"])
        time.sleep(0.3)
        subprocess.Popen(["plank"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    st["settings"]["dock_engine"] = "plank"
    ok("Dock Plank « KaliGlass » activé")


def _panels_array():
    v = xf_get("xfce4-panel", "/panels")
    return [int(x) for x in v["array"]] if isinstance(v, dict) else []


def _plugin_ids():
    ids = set()
    for p in xf_list("xfce4-panel"):
        m = re.match(r"/plugins/plugin-(\d+)", p)
        if m:
            ids.add(int(m.group(1)))
    return ids


def setup_xfce_dock(st):
    """Dock de secours (plank absent) : panneau XFCE en bas, centré, translucide."""
    if not have("xfconf-query"):
        warn("xfconf-query absent — pas de dock")
        return
    if st["settings"].get("xfce_dock_panel"):
        ok("Dock XFCE déjà en place")
        return
    panels = _panels_array() or panel_ids()
    pid = max(panels + [1]) + 1
    base = f"/panels/panel-{pid}"
    xf_set_array(st, "xfce4-panel", "/panels", panels + [pid], "int")
    for prop, val, typ in [("position", "p=10;x=0;y=0", "string"), ("position-locked", True, "bool"),
                           ("size", 56, "uint"), ("icon-size", 44, "uint"), ("length", 1, "uint"),
                           ("length-adjust", True, "bool"), ("autohide-behavior", 1, "uint"),
                           ("mode", 0, "uint"), ("background-style", 1, "uint"),
                           ("enter-opacity", 100, "uint"), ("leave-opacity", 100, "uint")]:
        xf_set(st, "xfce4-panel", f"{base}/{prop}", val, typ)
    xf_set_array(st, "xfce4-panel", f"{base}/background-rgba", [1.0, 1.0, 1.0, 0.18], "double")

    plug = max(_plugin_ids() | {0}) + 1
    files = dock_desktop_files()
    cfg = HOME / ".config" / "xfce4" / "panel"
    cfg.mkdir(parents=True, exist_ok=True)
    docklike = "ls /usr/lib/*/xfce4/panel/plugins/libdocklike* /usr/lib/xfce4/panel/plugins/libdocklike* 2>/dev/null"
    if run(["sh", "-c", docklike]).stdout.strip():
        xf_set(st, "xfce4-panel", f"/plugins/plugin-{plug}", "docklike", "string")
        (cfg / f"docklike-{plug}.rc").write_text("[user]\npinned=" + ";".join(str(f) for f in files) + ";\n")
        ids, kind = [plug], "docklike"
    else:  # simples lanceurs
        ids = []
        for i, f in enumerate(files):
            n = plug + i
            ldir = cfg / f"launcher-{n}"
            ldir.mkdir(parents=True, exist_ok=True)
            shutil.copy(f, ldir / f.name)
            xf_set(st, "xfce4-panel", f"/plugins/plugin-{n}", "launcher", "string")
            xf_set_array(st, "xfce4-panel", f"/plugins/plugin-{n}/items", [f.name], "string")
            ids.append(n)
        kind = "lanceurs"
    xf_set_array(st, "xfce4-panel", f"{base}/plugin-ids", ids, "int")
    st["settings"]["xfce_dock_panel"] = pid
    st["settings"]["xfce_dock_plugins"] = ids
    st["settings"]["dock_engine"] = "xfce"
    reload_panel()
    ok(f"Dock XFCE ({kind}) activé — plank n'est pas disponible sur ce système")


def remove_xfce_dock(st):
    pid = st["settings"].pop("xfce_dock_panel", None)
    if not pid:
        return
    panels = [p for p in _panels_array() if p != pid]
    if panels:
        xf_set_array(st, "xfce4-panel", "/panels", panels, "int")
    run(["xfconf-query", "-c", "xfce4-panel", "-p", f"/panels/panel-{pid}", "-r", "-R"])
    for n in st["settings"].pop("xfce_dock_plugins", []):
        run(["xfconf-query", "-c", "xfce4-panel", "-p", f"/plugins/plugin-{n}", "-r", "-R"])
    reload_panel()


# ───────────────────────── panneau, fenêtres, apparence ─────────────────────────

def panel_ids():
    ids = set()
    for p in xf_list("xfce4-panel"):
        m = re.match(r"/panels/panel-(\d+)/", p)
        if m:
            ids.add(int(m.group(1)))
    return sorted(ids) or [1]


def set_panel_opacity(st, pct):
    pct = max(0, min(100, int(pct)))
    dark = st["settings"].get("mode", "dark") == "dark"
    rgb = (0.08, 0.08, 0.12) if dark else (0.96, 0.96, 0.98)
    for i in panel_ids():
        if i == st["settings"].get("xfce_dock_panel"):
            continue
        base = f"/panels/panel-{i}"
        xf_set(st, "xfce4-panel", f"{base}/background-style", 1, "uint")
        xf_set_array(st, "xfce4-panel", f"{base}/background-rgba", [*rgb, round(pct / 100, 2)], "double")
    st["settings"]["panel_opacity"] = pct
    ok(f"Barre du haut : opacité {pct} %")


def style_panel(st):
    """Barre fine en haut, comme la barre de menus macOS."""
    first = panel_ids()[0]
    base = f"/panels/panel-{first}"
    xf_set(st, "xfce4-panel", f"{base}/position", "p=6;x=0;y=0", "string")
    xf_set(st, "xfce4-panel", f"{base}/position-locked", True, "bool")
    xf_set(st, "xfce4-panel", f"{base}/size", 28, "uint")
    xf_set(st, "xfce4-panel", f"{base}/icon-size", 16, "uint")
    xf_set(st, "xfce4-panel", f"{base}/length", 100, "uint")


def set_mode(st, mode):
    st["settings"]["mode"] = mode
    gtk = find_theme(mode)
    icons = find_icons(mode)
    cursors = find_cursors()
    if gtk:
        xf_set(st, "xsettings", "/Net/ThemeName", gtk, "string")
        xf_set(st, "xfwm4", "/general/theme", gtk, "string")
    else:
        warn("thème WhiteSur absent — lance : kali-glass install-themes")
    if icons:
        xf_set(st, "xsettings", "/Net/IconThemeName", icons, "string")
    if cursors:
        xf_set(st, "xsettings", "/Gtk/CursorThemeName", cursors, "string")
    # boutons à gauche comme sur macOS : fermer, réduire, agrandir
    xf_set(st, "xfwm4", "/general/button_layout", "CHM|", "string")
    xf_set(st, "xfwm4", "/general/title_alignment", "center", "string")
    fams = run(["fc-list", ":", "family"]).stdout or ""
    if any(f.split(",")[0].strip() == "Inter" for f in fams.splitlines()):
        xf_set(st, "xsettings", "/Gtk/FontName", "Inter 10", "string")
        xf_set(st, "xfwm4", "/general/title_font", "Inter Semi-Bold 10", "string")
    run(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme",
         "prefer-light" if mode == "light" else "prefer-dark"])
    install_gtk_css(mode)
    if "panel_opacity" in st["settings"]:
        set_panel_opacity(st, st["settings"]["panel_opacity"])
    ok(f"Mode {'clair' if mode == 'light' else 'sombre'}" + (f" ({gtk})" if gtk else ""))


def install_gtk_css(mode):
    src = data_dir() / "config" / "gtk-3.0" / "kali-glass.css"
    dst_dir = HOME / ".config" / "gtk-3.0"
    dst_dir.mkdir(parents=True, exist_ok=True)
    shutil.copy(src, dst_dir / "kali-glass.css")
    gtk_css = dst_dir / "gtk.css"
    line = '@import url("kali-glass.css");'
    cur = gtk_css.read_text() if gtk_css.exists() else ""
    if line not in cur:
        gtk_css.write_text(line + "\n" + cur)


def remove_gtk_css():
    gtk_css = HOME / ".config" / "gtk-3.0" / "gtk.css"
    if gtk_css.exists():
        gtk_css.write_text(gtk_css.read_text().replace('@import url("kali-glass.css");\n', ""))


def reload_panel():
    if os.environ.get("DISPLAY") and have("xfce4-panel"):
        run(["xfce4-panel", "-r"])


# ───────────────────────── commandes ─────────────────────────

def cmd_apply(a):
    st = load_state()
    print(f"\n  {_c('1', 'Kali Glass ' + VERSION)} — bureau verre façon macOS\n")
    if not a.no_themes:
        install_themes()
    st["settings"].setdefault("panel_opacity", 35)
    style_panel(st)
    set_mode(st, "light" if a.light else st["settings"].get("mode", "dark") if a.keep_mode else "dark")
    set_wallpaper(st, a.wallpaper or st["settings"].get("wallpaper") or ("light" if a.light else "aurora"))
    setup_picom(st)
    setup_dock(st, st["settings"].get("dock", True))
    st["settings"]["applied"] = True
    save_state(st)
    reload_panel()
    print("\n  ✨ Terminé. Si quelque chose ne s'affiche pas, déconnecte-toi puis reconnecte-toi.\n")


def cmd_wallpaper(a):
    st = load_state()
    if st["settings"].get("live", {}).get("active"):
        live_stop(st, quiet=True)
        info("Fond animé arrêté (remplacé par un fond fixe)")
    set_wallpaper(st, a.name)
    if a.name != "dynamic":
        st["settings"]["dynamic"] = False
        remove_autostart("dynamic")
    save_state(st)


def cmd_list(a):
    cur = load_state()["settings"].get("wallpaper")
    for w in wallpapers():
        n = w.stem.replace("kali-glass-", "")
        print(("● " if n == cur else "  ") + n + f"   {w}")


def cmd_mode(a):
    st = load_state()
    set_mode(st, a.mode)
    save_state(st)
    reload_panel()


def cmd_blur(a):
    if not 0 <= a.strength <= 20:
        die("La force du flou doit être entre 0 et 20.")
    st = load_state()
    setup_picom(st, a.strength)
    save_state(st)


def cmd_panel(a):
    if not 0 <= a.percent <= 100:
        die("L'opacité doit être entre 0 et 100.")
    st = load_state()
    set_panel_opacity(st, a.percent)
    save_state(st)


def cmd_dock(a):
    st = load_state()
    setup_dock(st, a.state == "on")
    save_state(st)


def cmd_dynamic(a):
    st = load_state()
    if a.state == "on":
        exe = shutil.which("kali-glass") or str(Path(__file__).resolve())
        write_autostart("dynamic", f"{exe} dynamic-daemon", "Fond d'écran selon l'heure")
        st["settings"]["dynamic"] = True
        set_wallpaper(st, dynamic_pick())
        save_state(st)
        if os.environ.get("DISPLAY"):
            subprocess.Popen([exe, "dynamic-daemon"], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        ok("Fond dynamique activé (change selon l'heure)")
    else:
        remove_autostart("dynamic")
        run(["pkill", "-f", "kali-glass dynamic-daemon"])
        st["settings"]["dynamic"] = False
        save_state(st)
        ok("Fond dynamique désactivé")


def cmd_dynamic_daemon(a):
    last = None
    while True:
        st = load_state()
        if not st["settings"].get("dynamic"):
            return
        pick = dynamic_pick()
        if pick != last:
            set_wallpaper(st, pick)
            save_state(st)
            last = pick
        time.sleep(300)


def cmd_install_themes(a):
    install_themes(force=True)


def cmd_login(a):
    wp = resolve_wallpaper(a.wallpaper)
    if os.geteuid() != 0:
        die("Cette commande doit être lancée avec sudo : sudo kali-glass login")
    dest = Path("/usr/share/backgrounds/kali-glass")
    dest.mkdir(parents=True, exist_ok=True)
    shutil.copy(wp, dest / "login.png")
    conf = Path("/etc/lightdm/lightdm-gtk-greeter.conf")
    if not conf.exists():
        die("lightdm-gtk-greeter non trouvé")
    shutil.copy(conf, str(conf) + ".kali-glass.bak") if not Path(str(conf) + ".kali-glass.bak").exists() else None
    text = conf.read_text()
    if re.search(r"^\s*background\s*=", text, re.M):
        text = re.sub(r"^\s*background\s*=.*$", f"background = {dest / 'login.png'}", text, flags=re.M)
    else:
        text = text.replace("[greeter]", f"[greeter]\nbackground = {dest / 'login.png'}", 1)
    conf.write_text(text)
    ok("Écran de connexion mis à jour (visible à la prochaine connexion)")


def cmd_restore(a):
    st = load_state()
    live_stop(st, quiet=True)
    for key, val in st.get("backup", {}).items():
        channel, prop = key.split(":", 1)
        if val is None:
            run(["xfconf-query", "-c", channel, "-p", prop, "-r"])
        elif isinstance(val, dict):
            cmd = ["xfconf-query", "-c", channel, "-p", prop, "--create", "--force-array"]
            for v in val["array"]:
                t = "int" if re.fullmatch(r"-?\d+", v) else "double" if re.fullmatch(r"-?\d+\.\d+", v) else "string"
                cmd += ["-t", t, "-s", v]
            run(["xfconf-query", "-c", channel, "-p", prop, "-r"])
            run(cmd)
        else:
            t = "bool" if val in ("true", "false") else "int" if re.fullmatch(r"-?\d+", val) else "string"
            r = run(["xfconf-query", "-c", channel, "-p", prop, "-s", val])
            if r.returncode != 0:
                run(["xfconf-query", "-c", channel, "-p", prop, "--create", "-t", t, "-s", val])
    for n in ("picom", "plank", "dynamic", "live"):
        remove_autostart(n)
    run(["pkill", "-x", "picom"]); run(["pkill", "-x", "plank"])
    run(["pkill", "-f", "kali-glass dynamic-daemon"])
    remove_gtk_css()
    if STATE_FILE.exists():
        STATE_FILE.rename(STATE_FILE.with_suffix(".restored.json"))
    reload_panel()
    ok("Réglages d'origine restaurés. Déconnecte-toi pour un retour complet.")


def cmd_status(a):
    st = load_state()["settings"]
    print(json.dumps({"version": VERSION, **st,
                      "picom": bool(run(["pgrep", "-x", "picom"]).stdout.strip()),
                      "plank": bool(run(["pgrep", "-x", "plank"]).stdout.strip()),
                      "live_running": bool(live_running()),
                      "gtk": find_theme(st.get("mode", "dark")), "data": str(data_dir())},
                     indent=2, ensure_ascii=False))


# ───────────────────────── fonds d'écran animés (vidéo) ─────────────────────────

REPO = "ck526438-lgtm/kali-glass"
LIVE_PACK = ["aurora", "ocean", "sunset", "midnight"]
LIVE_DIR = HOME / ".local" / "share" / "kali-glass" / "live"
THUMB_DIR = HOME / ".cache" / "kali-glass" / "thumbs"
VIDEO_EXT = {".mp4", ".webm", ".mkv", ".mov", ".m4v", ".avi", ".gif"}
LIVE_PIDFILE = HOME / ".cache" / "kali-glass" / "live.pid"


def live_exe():
    for c in (shutil.which("kali-glass-live"), Path(__file__).resolve().parent / "kali-glass-live"):
        if c and Path(c).exists():
            return str(c)
    die("kali-glass-live introuvable. Réinstalle le paquet.")


def live_name(f):
    n = re.sub(r"^kali-glass-live-", "", Path(f).stem)
    return re.sub(r"-\d{3,4}p$", "", n)


def live_library():
    """Vidéos disponibles : pack système éventuel + bibliothèque perso (~/.local/share/kali-glass/live)."""
    vids = {}
    dirs = [Path("/usr/share/kali-glass/live"), LIVE_DIR]
    for d in dirs:
        if d.is_dir():
            for f in sorted(d.iterdir()):
                if f.suffix.lower() in VIDEO_EXT:
                    vids[live_name(f)] = f
    return vids


def screen_height():
    r = run(["xrandr", "--current"])
    m = re.findall(r"\s(\d+)x(\d+)\+\d+\+\d+", r.stdout or "")
    return max((int(h) for _w, h in m), default=1080)


def download(url, dest):
    import urllib.request
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_suffix(dest.suffix + ".part")
    req = urllib.request.Request(url, headers={"User-Agent": f"kali-glass/{VERSION}"})
    with urllib.request.urlopen(req, timeout=60) as r, tmp.open("wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        done = 0
        while chunk := r.read(1 << 20):
            f.write(chunk)
            done += len(chunk)
            if total and sys.stdout.isatty():
                pct = done * 100 // total
                print(f"\r    {dest.name}  {pct:3d} %  {done / 1e6:6.1f}/{total / 1e6:.1f} Mo", end="", flush=True)
    if sys.stdout.isatty():
        print()
    tmp.replace(dest)
    return dest


def live_running():
    try:
        pid = int(LIVE_PIDFILE.read_text())
        return pid if "kali-glass-live" in Path(f"/proc/{pid}/cmdline").read_text() else None
    except (OSError, ValueError):
        return None


def xfdesktop_stop(st):
    """Le bureau XFCE (icônes) se dessine au-dessus de la vidéo : on le met en veille."""
    if run(["pgrep", "-x", "xfdesktop"]).stdout.strip():
        run(["xfdesktop", "--quit"])
        st["settings"].setdefault("live", {})["xfdesktop_stopped"] = True


def xfdesktop_start(st):
    if st["settings"].get("live", {}).pop("xfdesktop_stopped", False) and os.environ.get("DISPLAY") \
            and not run(["pgrep", "-x", "xfdesktop"]).stdout.strip() and have("xfdesktop"):
        subprocess.Popen(["xfdesktop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def live_start(st):
    exe = live_exe()
    write_autostart("live", exe, "Fond d'écran animé")
    pid = live_running()
    if pid:
        os.kill(pid, signal.SIGTERM)
        time.sleep(0.6)
    if os.environ.get("DISPLAY"):
        xfdesktop_stop(st)
        save_state(st)
        subprocess.Popen([exe], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def live_stop(st, quiet=False):
    remove_autostart("live")
    pid = live_running()
    if pid:
        os.kill(pid, signal.SIGTERM)
    xfdesktop_start(st)
    if "live" in st["settings"]:
        st["settings"]["live"]["active"] = False
    if not quiet:
        ok("Fond animé arrêté")


def resolve_video(name):
    if re.match(r"^https?://", name):
        fname = re.sub(r"[^\w.\-]", "_", name.rsplit("/", 1)[-1].split("?")[0]) or "video.mp4"
        if Path(fname).suffix.lower() not in VIDEO_EXT:
            fname += ".mp4"
        info(f"Téléchargement de {name}…")
        try:
            return download(name, LIVE_DIR / fname)
        except Exception as e:  # noqa: BLE001
            die(f"Téléchargement impossible : {e}")
    p = Path(os.path.expanduser(name))
    if p.is_file():
        if p.suffix.lower() not in VIDEO_EXT:
            die(f"Format non pris en charge : {p.suffix}. Formats : {', '.join(sorted(VIDEO_EXT))}")
        return p.resolve()
    lib = live_library()
    if name in lib:
        return lib[name]
    if name in LIVE_PACK:
        die(f"« {name} » n'est pas encore téléchargé. Lance : kali-glass live download")
    die(f"Vidéo « {name} » introuvable. Disponibles : {', '.join(lib) or 'aucune'}")


def cmd_live_set(a):
    if not have("mpv"):
        die("mpv est requis : sudo apt install mpv")
    if a.speed is not None and not 0.1 <= a.speed <= 4:
        die("La vitesse doit être entre 0.1 et 4")
    st = load_state()
    video = resolve_video(a.video)
    lv = st["settings"].setdefault("live", {})
    lv.update(video=str(video), active=True)
    if a.audio:
        lv["audio"] = True
    if a.speed is not None:
        lv["speed"] = a.speed
    lv.setdefault("pause_fullscreen", True)
    lv.setdefault("pause_battery", True)
    if live_name(video) in LIVE_PACK:  # fond fixe assorti (visible au démarrage de la session)
        set_wallpaper(st, live_name(video))
    live_start(st)
    save_state(st)
    ok(f"Fond animé : {video.name}")
    if not os.environ.get("DISPLAY"):
        warn("Pas de session graphique : il démarrera à la prochaine connexion")


def cmd_live_stop(a):
    st = load_state()
    live_stop(st)
    save_state(st)


def cmd_live_toggle(a):
    pid = live_running()
    if not pid:
        die("Aucun fond animé en cours")
    os.kill(pid, signal.SIGUSR1)
    ok("Pause / reprise")


def cmd_live_list(a):
    lv = load_state()["settings"].get("live", {})
    cur = lv.get("video") if lv.get("active") else None
    lib = live_library()
    for n, f in lib.items():
        print(("● " if str(f) == cur else "  ") + f"{n:<16} {f.stat().st_size / 1e6:7.1f} Mo   {f}")
    missing = [n for n in LIVE_PACK if n not in lib]
    if missing:
        print(f"\n  Pack non téléchargé : {', '.join(missing)}  →  kali-glass live download")


def cmd_live_download(a):
    q = a.quality
    if q == "auto":
        q = "2160p" if screen_height() > 1200 else "1080p"
    names = [n.strip() for n in a.only.split(",")] if a.only else LIVE_PACK
    for n in names:
        if n not in LIVE_PACK:
            die(f"« {n} » ne fait pas partie du pack : {', '.join(LIVE_PACK)}")
    info(f"Pack de fonds animés en {q} ({len(names)} vidéos)")
    for n in names:
        fname = f"kali-glass-live-{n}-{q}.mp4"
        dest = LIVE_DIR / fname
        if dest.exists() and not a.force:
            ok(f"{fname} déjà présent")
            continue
        url = f"https://github.com/{REPO}/releases/latest/download/{fname}"
        try:
            download(url, dest)
        except Exception as e:  # noqa: BLE001
            die(f"Téléchargement impossible ({e}). Télécharge-le depuis https://github.com/{REPO}/releases/latest")
        ok(f"{fname} ({dest.stat().st_size / 1e6:.0f} Mo)")
    ok(f"Pack installé dans {LIVE_DIR}. Exemple : kali-glass live set aurora")


def cmd_live_add(a):
    src = Path(os.path.expanduser(a.file))
    if not src.is_file() or src.suffix.lower() not in VIDEO_EXT:
        die("Donne un fichier vidéo existant (" + ", ".join(sorted(VIDEO_EXT)) + ")")
    LIVE_DIR.mkdir(parents=True, exist_ok=True)
    dest = LIVE_DIR / src.name
    if src.resolve() != dest.resolve():
        shutil.copy2(src, dest)
    ok(f"Ajouté à la bibliothèque : {live_name(dest)}")


def cmd_live_options(a):
    st = load_state()
    lv = st["settings"].setdefault("live", {})
    changed = []
    for k in ("audio", "pause_fullscreen", "pause_battery"):
        v = getattr(a, k)
        if v is not None:
            lv[k] = v == "on"
            changed.append(f"{k}={v}")
    if a.speed is not None:
        if not 0.1 <= a.speed <= 4:
            die("La vitesse doit être entre 0.1 et 4")
        lv["speed"] = a.speed
        changed.append(f"speed={a.speed}")
    save_state(st)
    if changed and lv.get("active") and live_running():
        live_start(st)
        save_state(st)
    cur = {k: lv.get(k) for k in ("audio", "speed", "pause_fullscreen", "pause_battery")}
    ok("Options : " + (", ".join(changed) or json.dumps(cur, ensure_ascii=False)))


def cmd_live_thumb(a):
    """Miniature d'une vidéo (utilisée par Glass Center)."""
    video = resolve_video(a.video)
    THUMB_DIR.mkdir(parents=True, exist_ok=True)
    out = THUMB_DIR / f"{live_name(video)}.jpg"
    if not out.exists() or out.stat().st_mtime < video.stat().st_mtime:
        for ss in (["-ss", "2"], []):
            r = run(["ffmpeg", "-y", "-loglevel", "error", *ss, "-i", str(video), "-frames:v", "1",
                     "-vf", "scale=480:-2", str(out)])
            if r.returncode == 0 and out.exists():
                break
    if not out.exists():
        die("Miniature impossible (ffmpeg absent ?)")
    print(out)


def _picom_version():
    out = run(["picom", "--version"]).stdout.strip()
    m = re.search(r"(\d+)(?:\.(\d+))?", out)
    return (int(m.group(1)), int(m.group(2) or 0), out) if m else (0, 0, out)


def cmd_doctor(a):
    """Diagnostic complet : ce qui marche, ce qui manque, et comment le réparer."""
    rows, errors = [], 0

    def check(name, good, detail="", hint="", level="err"):
        nonlocal errors
        sym = _c("1;32", "✓") if good else (_c("1;31", "✗") if level == "err" else _c("1;33", "⚠"))
        if not good and level == "err":
            errors += 1
        rows.append((sym, name, detail, "" if good else hint))

    desk = os.environ.get("XDG_CURRENT_DESKTOP", "")
    check("Session XFCE", "XFCE" in desk.upper(), desk or "inconnue", "Kali Glass vise le bureau XFCE (défaut de Kali)", "warn")
    check("Affichage X11", bool(os.environ.get("DISPLAY")) and not os.environ.get("WAYLAND_DISPLAY"),
          os.environ.get("DISPLAY", "aucun"), "picom et Plank exigent X11", "warn")
    check("xfconf-query", have("xfconf-query"), "", "sudo apt install xfconf")
    if have("picom"):
        ma, mi, raw = _picom_version()
        check("picom ≥ 10", ma >= 10, raw, "picom trop ancien : le flou dual_kawase demande la v10+")
        check("picom actif", bool(run(["pgrep", "-x", "picom"]).stdout.strip()), "", "kali-glass blur 7", "warn")
    else:
        check("picom", False, "absent", "sudo apt install picom")
    if have("glxinfo"):
        gl = run(["glxinfo", "-B"]).stdout
        renderer = (re.search(r"OpenGL renderer string: (.*)", gl) or [None, "?"])[1]
        soft = "llvmpipe" in renderer or "softpipe" in renderer
        check("Accélération 3D (flou)", not soft, renderer,
              "Rendu logiciel : active l'accélération 3D de ta VM, sinon le flou sera lent", "warn")
    else:
        check("Accélération 3D (flou)", False, "glxinfo absent", "sudo apt install mesa-utils pour vérifier", "warn")
    check("mpv (fonds animés)", have("mpv"), "", "sudo apt install mpv", "warn")
    check("ffmpeg (miniatures)", have("ffmpeg"), "", "sudo apt install ffmpeg", "warn")
    check("xprop (pause auto)", have("xprop"), "", "sudo apt install x11-utils", "warn")
    dock = "plank" if have("plank") else ("panneau XFCE" if have("xfconf-query") else "aucun")
    check("Dock", dock != "aucun", dock, "sudo apt install plank (ou xfce4-docklike-plugin)", "warn")
    check("Thème GTK WhiteSur", bool(find_theme("dark")), find_theme("dark") or "absent", "kali-glass install-themes")
    check("Icônes WhiteSur", bool(find_icons("dark")), find_icons("dark") or "absent", "kali-glass install-themes", "warn")
    fams = run(["fc-list", ":", "family"]).stdout or ""
    check("Police Inter", any(f.split(",")[0].strip() == "Inter" for f in fams.splitlines()), "",
          "sudo apt install fonts-inter", "warn")
    try:
        import gi  # noqa: F401
        gi_ok = True
    except Exception:
        gi_ok = False
    check("PyGObject (Glass Center)", gi_ok, "", "sudo apt install python3-gi gir1.2-gtk-3.0", "warn")
    try:
        check("Fonds d'écran", len(wallpapers()) > 0, f"{len(wallpapers())} dans {data_dir()}", "réinstalle le paquet")
    except SystemExit:
        check("Fonds d'écran", False, "introuvables", "réinstalle le paquet")
    st = load_state()
    check("Thème appliqué", bool(st["settings"].get("applied")), STATE_FILE if STATE_FILE.exists() else "jamais",
          "kali-glass apply", "warn")

    print(f"\n  {_c('1', 'Kali Glass ' + VERSION + ' — diagnostic')}\n")
    w = max(len(r[1]) for r in rows)
    for sym, name, detail, hint in rows:
        line = f"  {sym} {name.ljust(w)}  {_c('2', str(detail))}"
        print(line + (f"\n      → {hint}" if hint else ""))
    print(f"\n  Journal : {LOG_FILE}\n")
    sys.exit(1 if errors else 0)


def main():
    p = argparse.ArgumentParser(prog="kali-glass", description="Bureau Glass façon macOS pour Kali Linux")
    p.add_argument("--version", action="version", version=VERSION)
    p.add_argument("-v", "--verbose", action="store_true", help="affiche chaque commande exécutée")
    sp = p.add_subparsers(dest="cmd", required=True)
    s = sp.add_parser("apply"); s.add_argument("--light", action="store_true"); s.add_argument("--wallpaper")
    s.add_argument("--no-themes", action="store_true"); s.add_argument("--keep-mode", action="store_true")
    s.set_defaults(f=cmd_apply)
    s = sp.add_parser("wallpaper"); s.add_argument("name"); s.set_defaults(f=cmd_wallpaper)
    sp.add_parser("list").set_defaults(f=cmd_list)
    s = sp.add_parser("mode"); s.add_argument("mode", choices=["dark", "light"]); s.set_defaults(f=cmd_mode)
    s = sp.add_parser("blur"); s.add_argument("strength", type=int); s.set_defaults(f=cmd_blur)
    s = sp.add_parser("panel-opacity"); s.add_argument("percent", type=int); s.set_defaults(f=cmd_panel)
    s = sp.add_parser("dock"); s.add_argument("state", choices=["on", "off"]); s.set_defaults(f=cmd_dock)
    s = sp.add_parser("dynamic"); s.add_argument("state", choices=["on", "off"]); s.set_defaults(f=cmd_dynamic)
    sp.add_parser("dynamic-daemon").set_defaults(f=cmd_dynamic_daemon)
    sp.add_parser("install-themes").set_defaults(f=cmd_install_themes)
    s = sp.add_parser("login"); s.add_argument("--wallpaper", default="aurora"); s.set_defaults(f=cmd_login)
    sp.add_parser("restore").set_defaults(f=cmd_restore)
    sp.add_parser("status").set_defaults(f=cmd_status)
    sp.add_parser("doctor", help="diagnostic de l'installation").set_defaults(f=cmd_doctor)

    lp = sp.add_parser("live", help="fonds d'écran animés (vidéo)")
    lsp = lp.add_subparsers(dest="live_cmd", required=True)
    s = lsp.add_parser("set", help="joue une vidéo en fond (nom, fichier ou URL)")
    s.add_argument("video")
    s.add_argument("--audio", action="store_true")
    s.add_argument("--speed", type=float)
    s.set_defaults(f=cmd_live_set)
    lsp.add_parser("stop", help="arrête le fond animé").set_defaults(f=cmd_live_stop)
    lsp.add_parser("toggle", help="pause / reprise").set_defaults(f=cmd_live_toggle)
    lsp.add_parser("list", help="vidéos disponibles").set_defaults(f=cmd_live_list)
    s = lsp.add_parser("download", help="télécharge le pack de fonds animés")
    s.add_argument("--quality", choices=["auto", "2160p", "1080p"], default="auto")
    s.add_argument("--only", help="ex. aurora,ocean")
    s.add_argument("--force", action="store_true")
    s.set_defaults(f=cmd_live_download)
    s = lsp.add_parser("add", help="copie une vidéo dans la bibliothèque")
    s.add_argument("file")
    s.set_defaults(f=cmd_live_add)
    s = lsp.add_parser("options", help="son, vitesse, pauses automatiques")
    s.add_argument("--audio", choices=["on", "off"])
    s.add_argument("--pause-fullscreen", dest="pause_fullscreen", choices=["on", "off"])
    s.add_argument("--pause-battery", dest="pause_battery", choices=["on", "off"])
    s.add_argument("--speed", type=float)
    s.set_defaults(f=cmd_live_options)
    s = lsp.add_parser("thumb", help="miniature d'une vidéo")
    s.add_argument("video")
    s.set_defaults(f=cmd_live_thumb)
    a = p.parse_args()
    global VERBOSE
    VERBOSE = a.verbose
    log(f"RUN   kali-glass {' '.join(sys.argv[1:])}")
    if os.geteuid() == 0 and a.cmd not in ("login", "list", "status", "doctor") \
            and not os.environ.get("KALI_GLASS_ALLOW_ROOT"):
        die("Ne lance pas kali-glass avec sudo (les réglages sont propres à ton utilisateur).")
    a.f(a)


if __name__ == "__main__":
    main()
