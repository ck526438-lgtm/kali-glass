class GlassCenter(Gtk.Window):
    def __init__(self):
        super().__init__(title="Glass Center")
        self.set_default_size(980, 640)
        self.set_icon_name("glass-center")
        self.st = state()
        self.busy = False

        # Fenêtre transparente (picom floute ce qui est derrière)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        ctx = self.get_style_context()
        ctx.add_class("glass")
        if visual and screen.is_composited():
            self.set_visual(visual)
            self.set_app_paintable(True)
        else:
            ctx.add_class("opaque")  # pas de compositeur : fond plein lisible
        if self.st.get("mode") == "light":
            ctx.add_class("light")
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(screen, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        hb = Gtk.HeaderBar(show_close_button=True)
        hb.set_decoration_layout("close,minimize,maximize:")  # boutons à gauche façon macOS
        hb.set_title("Glass Center")
        self.set_titlebar(hb)

        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(root)

        # Barre latérale
        side = Gtk.ListBox()
        side.get_style_context().add_class("sidebar")
        side.set_size_request(210, -1)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=180)
        pages = [
            ("wall", "🖼  Fonds d'écran", self.page_wallpapers()),
            ("live", "🎬  Fonds animés", self.page_live()),
            ("look", "✨  Apparence", self.page_look()),
            ("dock", "⚓  Dock & barre", self.page_dock()),
            ("doctor", "🩺  Diagnostic", self.page_doctor()),
            ("about", "ℹ  À propos", self.page_about()),
        ]
        for key, label, widget in pages:
            row = Gtk.ListBoxRow()
            row.add(Gtk.Label(label=label, xalign=0))
            row.key = key
            side.add(row)
            self.stack.add_named(widget, key)
        side.connect("row-selected", lambda _l, r: r and self.stack.set_visible_child_name(r.key))
        side.select_row(side.get_row_at_index(0))
        root.pack_start(side, False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        right.pack_start(self.stack, True, True, 0)
        bar = Gtk.Box(spacing=10, margin=16)
        self.status = Gtk.Label(label="Prêt.", xalign=0)
        self.status.get_style_context().add_class("status")
        self.spinner = Gtk.Spinner()
        restore = Gtk.Button(label="Restaurer l'original")
        restore.get_style_context().add_class("ghost")
        restore.connect("clicked", self.on_restore)
        apply_all = Gtk.Button(label="Appliquer Kali Glass")
        apply_all.get_style_context().add_class("big")
        apply_all.connect("clicked", lambda _b: self.run("apply", "--keep-mode", msg="Application du thème complet…"))
        bar.pack_start(self.spinner, False, False, 0)
        bar.pack_start(self.status, True, True, 0)
        bar.pack_end(apply_all, False, False, 0)
        bar.pack_end(restore, False, False, 0)
        right.pack_end(bar, False, False, 0)
        root.pack_start(right, True, True, 0)

    # ───────── pages ─────────
    def header(self, box, title, sub):
        t = Gtk.Label(label=title, xalign=0)
        t.get_style_context().add_class("title")
        s = Gtk.Label(label=sub, xalign=0, wrap=True)
        s.get_style_context().add_class("subtitle")
        box.pack_start(t, False, False, 0)
        box.pack_start(s, False, False, 0)

    def page(self):
        sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=24)
        sc.add(box)
        return sc, box

    def card(self, box, title, desc, control):
        c = Gtk.Box(spacing=16)
        c.get_style_context().add_class("card")
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        t = Gtk.Label(label=title, xalign=0)
        t.set_markup(f"<b>{GLib.markup_escape_text(title)}</b>")
        d = Gtk.Label(label=desc, xalign=0, wrap=True)
        d.get_style_context().add_class("subtitle")
        v.pack_start(t, False, False, 0)
        v.pack_start(d, False, False, 0)
        c.pack_start(v, True, True, 0)
        control.set_valign(Gtk.Align.CENTER)
        c.pack_end(control, False, False, 0)
        box.pack_start(c, False, False, 0)

    def page_wallpapers(self):
        sc, box = self.page()
        self.header(box, "Fonds d'écran", "Verre dépoli, halos lumineux. Clique pour appliquer.")
        flow = Gtk.FlowBox(max_children_per_line=3, min_children_per_line=2, selection_mode=Gtk.SelectionMode.NONE,
                           column_spacing=10, row_spacing=10, homogeneous=True)
        self.thumbs = {}
        cur = self.st.get("wallpaper")
        for wp in sorted((data_dir() / "wallpapers").glob("kali-glass-*.jpg")):
            name = wp.stem.replace("kali-glass-", "")
            btn = Gtk.Button(relief=Gtk.ReliefStyle.NONE)
            btn.get_style_context().add_class("thumb")
            if name == cur:
                btn.get_style_context().add_class("active")
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            img = Gtk.Image()
            v.pack_start(img, False, False, 0)
            v.pack_start(Gtk.Label(label=name.capitalize()), False, False, 0)
            btn.add(v)
            btn.connect("clicked", self.on_wallpaper, name)
            self.thumbs[name] = btn
            flow.add(btn)
            self.load_thumb(wp, img)
        box.pack_start(flow, False, False, 0)

        own = Gtk.FileChooserButton(title="Choisir une image", action=Gtk.FileChooserAction.OPEN)
        f = Gtk.FileFilter()
        f.add_mime_type("image/png"); f.add_mime_type("image/jpeg"); f.add_mime_type("image/webp")
        own.add_filter(f)
        own.connect("file-set", lambda b: self.run("wallpaper", b.get_filename(), msg="Fond personnalisé…"))
        self.card(box, "Ta propre image", "Utilise n'importe quelle photo comme fond.", own)

        dyn = Gtk.Switch(active=bool(self.st.get("dynamic")))
        dyn.connect("state-set", lambda _s, on: self.run("dynamic", "on" if on else "off", msg="Fond dynamique…") or False)
        self.card(box, "Fond dynamique", "Clair le matin, océan l'après-midi, coucher de soleil le soir, nuit ensuite.", dyn)
        return sc

    # ───────── fonds animés ─────────
    def page_live(self):
        sc, box = self.page()
        self.header(box, "Fonds animés", "Vidéos en boucle derrière tes fenêtres, jusqu'en 4K. "
                    "MP4, WebM, MKV, MOV ou GIF.")
        self.live_flow = Gtk.FlowBox(max_children_per_line=3, min_children_per_line=2,
                                     selection_mode=Gtk.SelectionMode.NONE,
                                     column_spacing=10, row_spacing=10, homogeneous=True)
        box.pack_start(self.live_flow, False, False, 0)

        actions = Gtk.Box(spacing=10)
        add = Gtk.Button(label="Ajouter une vidéo…")
        add.get_style_context().add_class("ghost")
        add.connect("clicked", self.on_live_add)
        dl = Gtk.Button(label="Télécharger le pack 4K")
        dl.get_style_context().add_class("big")
        dl.connect("clicked", lambda _b: self.run("live", "download", msg="Téléchargement du pack (quelques minutes)…",
                                                   then=self.refresh_live))
        stop = Gtk.Button(label="Arrêter")
        stop.get_style_context().add_class("ghost")
        stop.connect("clicked", lambda _b: self.run("live", "stop", msg="Arrêt du fond animé…", then=self.refresh_live))
        actions.pack_start(dl, False, False, 0)
        actions.pack_start(add, False, False, 0)
        actions.pack_end(stop, False, False, 0)
        box.pack_start(actions, False, False, 0)

        lv = self.st.get("live", {})
        for key, title, desc, default in [
            ("pause-fullscreen", "Pause en plein écran", "Économise le processeur quand une fenêtre cache le bureau.",
             lv.get("pause_fullscreen", True)),
            ("pause-battery", "Pause sur batterie", "Fige la vidéo quand le portable n'est pas branché.",
             lv.get("pause_battery", True)),
            ("audio", "Son de la vidéo", "Désactivé par défaut.", lv.get("audio", False)),
        ]:
            sw = Gtk.Switch(active=bool(default))
            sw.connect("state-set", lambda _s, on, k=key: self.run("live", "options", f"--{k}", "on" if on else "off",
                                                                     msg="Options…") or False)
            self.card(box, title, desc, sw)

        speed = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.25, 2.0, 0.25)
        speed.set_value(lv.get("speed", 1.0))
        speed.set_size_request(240, -1)
        speed.connect("button-release-event",
                      lambda s, _e: self.run("live", "options", "--speed", f"{s.get_value():.2f}", msg="Vitesse…") or False)
        self.card(box, "Vitesse", "Ralentis pour un effet plus calme.", speed)
        self.card(box, "Astuce", "Clic droit sur le bureau animé : Glass Center, terminal, pause, arrêt.",
                  Gtk.Label(label=""))
        self.refresh_live()
        return sc

    def refresh_live(self):
        for c in self.live_flow.get_children():
            self.live_flow.remove(c)
        self.live_thumbs = {}
        self.st = state()
        lv = self.st.get("live", {})
        cur = lv.get("video") if lv.get("active") else None
        vids = live_videos()
        if not vids:
            lab = Gtk.Label(label="Aucune vidéo pour l'instant. Télécharge le pack ou ajoute la tienne.", xalign=0)
            lab.get_style_context().add_class("subtitle")
            self.live_flow.add(lab)
        for name, path in vids:
            btn = Gtk.Button(relief=Gtk.ReliefStyle.NONE)
            btn.get_style_context().add_class("thumb")
            if str(path) == cur:
                btn.get_style_context().add_class("active")
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            img = Gtk.Image.new_from_icon_name("video-x-generic", Gtk.IconSize.DIALOG)
            img.set_size_request(240, 135)
            v.pack_start(img, False, False, 0)
            v.pack_start(Gtk.Label(label="▶ " + name.capitalize()), False, False, 0)
            btn.add(v)
            btn.connect("clicked", lambda _b, p=path: self.run("live", "set", str(p), msg="Fond animé…",
                                                               then=self.refresh_live))
            self.live_flow.add(btn)
            self.live_thumbs[str(path)] = btn
            self.load_video_thumb(path, img)
        self.live_flow.show_all()

    def load_video_thumb(self, path, img):
        def work():
            r = subprocess.run([cli(), "live", "thumb", str(path)], text=True, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, env=dict(os.environ, NO_COLOR="1"))
            out = (r.stdout or "").strip().splitlines()
            if r.returncode == 0 and out and Path(out[-1]).exists():
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(out[-1], 240, 135, True)
                    GLib.idle_add(img.set_from_pixbuf, pb)
                except Exception:
                    pass
        threading.Thread(target=work, daemon=True).start()

    def on_live_add(self, _b):
        d = Gtk.FileChooserDialog(title="Choisir une vidéo", transient_for=self, action=Gtk.FileChooserAction.OPEN)
        d.add_buttons("Annuler", Gtk.ResponseType.CANCEL, "Utiliser", Gtk.ResponseType.OK)
        f = Gtk.FileFilter()
        f.set_name("Vidéos")
        for m in ("video/mp4", "video/webm", "video/x-matroska", "video/quicktime", "image/gif"):
            f.add_mime_type(m)
        d.add_filter(f)
        if d.run() == Gtk.ResponseType.OK:
            path = d.get_filename()
            self.run("live", "add", path, msg="Ajout…",
                     then=lambda: self.run("live", "set", path, msg="Fond animé…", then=self.refresh_live))
        d.destroy()

    def load_thumb(self, path, img):
        def work():
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), 240, 135, True)
                GLib.idle_add(img.set_from_pixbuf, pb)
            except Exception:
                pass
        threading.Thread(target=work, daemon=True).start()

    def page_look(self):
        sc, box = self.page()
        self.header(box, "Apparence", "Mode, flou du verre et transparence.")
        mode = Gtk.Switch(active=self.st.get("mode") == "light")
        mode.connect("state-set", self.on_mode)
        self.card(box, "Mode clair", "Bascule entre WhiteSur sombre et clair.", mode)

        blur = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 20, 1)
        blur.set_value(self.st.get("blur", 7)); blur.set_size_request(240, -1)
        blur.connect("button-release-event", lambda s, _e: self.run("blur", str(int(s.get_value())), msg="Flou…") or False)
        self.card(box, "Intensité du flou", "0 = pas de flou. 6 à 9 donne le rendu « verre » macOS.", blur)

        restart = Gtk.Button(label="Redémarrer")
        restart.get_style_context().add_class("ghost")
        restart.connect("clicked", lambda _b: self.run("blur", str(int(blur.get_value())), msg="Compositeur…"))
        self.card(box, "Compositeur picom", "Relance picom si le flou disparaît.", restart)
        return sc

    def page_dock(self):
        sc, box = self.page()
        self.header(box, "Dock & barre", "Le dock en bas et la barre de menus en haut, comme sur macOS.")
        dock = Gtk.Switch(active=self.st.get("dock", True))
        dock.connect("state-set", lambda _s, on: self.run("dock", "on" if on else "off", msg="Dock…") or False)
        self.card(box, "Dock Plank", "Dock en verre avec effet loupe (zoom 150 %).", dock)

        op = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5)
        op.set_value(self.st.get("panel_opacity", 35)); op.set_size_request(240, -1)
        op.connect("button-release-event",
                   lambda s, _e: self.run("panel-opacity", str(int(s.get_value())), msg="Barre…") or False)
        self.card(box, "Opacité de la barre du haut", "Plus c'est bas, plus on voit le fond à travers.", op)
        return sc

    def page_doctor(self):
        sc, box = self.page()
        self.header(box, "Diagnostic", "Vérifie les dépendances, la carte graphique et les thèmes.")
        btn = Gtk.Button(label="Lancer le diagnostic")
        btn.get_style_context().add_class("big")
        btn.set_halign(Gtk.Align.START)
        self.doctor_view = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                        wrap_mode=Gtk.WrapMode.WORD_CHAR)
        self.doctor_view.get_style_context().add_class("card")
        self.doctor_view.get_buffer().set_text("Clique sur « Lancer le diagnostic ».")
        btn.connect("clicked", self.on_doctor)
        box.pack_start(btn, False, False, 0)
        box.pack_start(self.doctor_view, True, True, 0)
        return sc

    def on_doctor(self, _b):
        self.doctor_view.get_buffer().set_text("Analyse en cours…")

        def work():
            env = dict(os.environ, NO_COLOR="1")
            r = subprocess.run([cli(), "doctor"], text=True, env=env,
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            GLib.idle_add(self.doctor_view.get_buffer().set_text, r.stdout.strip() or "Aucune sortie.")
        threading.Thread(target=work, daemon=True).start()

    def page_about(self):
        sc, box = self.page()
        self.header(box, "Kali Glass", "Bureau verre façon macOS pour Kali Linux (XFCE).")
        txt = Gtk.Label(xalign=0, wrap=True, selectable=True)
        txt.set_markup(
            f"Version {version()} — par <b>ck526438-lgtm</b>\n\n"
            "• Thème GTK, icônes et curseurs : WhiteSur de vinceliuice (GPL-3.0 / MIT)\n"
            "• Flou : picom (dual_kawase)\n"
            "• Dock : Plank\n\n"
            "En ligne de commande : <tt>kali-glass --help</tt>\n"
            "<a href='https://github.com/ck526438-lgtm/kali-glass'>github.com/ck526438-lgtm/kali-glass</a>")
        box.pack_start(txt, False, False, 0)
        return sc

    # ───────── actions ─────────
    def run(self, *args, msg="…", then=None):
        if self.busy:
            return
        self.busy = True
        self.then = then
        self.spinner.start()
        self.status.set_text(msg)

        def work():
            r = subprocess.run([cli(), *args], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               env=dict(os.environ, NO_COLOR="1"))
            out = (r.stdout or "").strip().splitlines()
            last = out[-1] if out else ""
            GLib.idle_add(self.done, r.returncode == 0, last)
        threading.Thread(target=work, daemon=True).start()

    def done(self, success, last):
        self.busy = False
        then, self.then = getattr(self, "then", None), None
        self.spinner.stop()
        clean = last.replace("\033[1;32m", "").replace("\033[1;31m", "").replace("\033[0m", "").replace("\033[1;36m", "")
        self.status.set_text(("✓ " if success else "✗ ") + (clean.lstrip("✓✗› ").strip() or ("Fait." if success else "Erreur.")))
        self.st = state()
        cur = self.st.get("wallpaper")
        for n, b in self.thumbs.items():
            (b.get_style_context().add_class if n == cur else b.get_style_context().remove_class)("active")
        if then and success:
            then()
        return False

    def on_wallpaper(self, _b, name):
        self.run("wallpaper", name, msg=f"Fond « {name} »…")

    def on_mode(self, _s, on):
        ctx = self.get_style_context()
        (ctx.add_class if on else ctx.remove_class)("light")
        self.run("mode", "light" if on else "dark", msg="Changement de mode…")
        return False

    def on_restore(self, _b):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.OK_CANCEL, text="Restaurer le bureau d'origine ?")
        d.format_secondary_text("Le thème, le fond, la barre et le dock reviendront comme avant Kali Glass.")
        if d.run() == Gtk.ResponseType.OK:
            self.run("restore", msg="Restauration…")
        d.destroy()


def main():
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        print("Glass Center nécessite une session graphique.")
        return
    win = GlassCenter()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


