#!/usr/bin/env python3
"""Glass Center — panneau de réglages du bureau Kali Glass (GTK 3)."""
import json
import os
import re
import shutil
import subprocess
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf, GLib, Gtk  # noqa: E402

APP_ID = "io.github.ck526438.GlassCenter"
STATE = Path.home() / ".config" / "kali-glass" / "state.json"
HERE = Path(__file__).resolve().parent


def cli():
    for c in (shutil.which("kali-glass"), HERE.parent.parent / "bin" / "kali-glass", "/usr/bin/kali-glass"):
        if c and Path(c).exists():
            return str(c)
    return "kali-glass"


def data_dir():
    for d in (HERE.parent.parent, Path("/usr/share/kali-glass"), Path.home() / ".local/share/kali-glass"):
        if (d / "wallpapers").is_dir():
            return d
    return Path("/usr/share/kali-glass")


def version():
    try:
        return subprocess.run([cli(), "--version"], text=True, stdout=subprocess.PIPE, timeout=5).stdout.strip()
    except Exception:
        return "?"


def live_videos():
    exts = {".mp4", ".webm", ".mkv", ".mov", ".m4v", ".avi", ".gif"}
    out = []
    for d in (Path("/usr/share/kali-glass/live"), Path.home() / ".local/share/kali-glass/live"):
        if d.is_dir():
            for f in sorted(d.iterdir()):
                if f.suffix.lower() in exts:
                    n = re.sub(r"-\d{3,4}p$", "", re.sub(r"^kali-glass-live-", "", f.stem))
                    out.append((n, f))
    return out


def state():
    try:
        return json.loads(STATE.read_text()).get("settings", {})
    except Exception:
        return {}


